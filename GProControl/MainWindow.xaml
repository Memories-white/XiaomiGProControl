<Window
    x:Class="GProControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="G Pro Control">
    <Grid x:Name="Shell">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="GamingShellBackground" Grid.RowSpan="2" Background="#111111"
                Visibility="Collapsed" IsHitTestVisible="False" />
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Border x:Name="GamingTitleBackground" Background="#181818" BorderBrush="#323032"
                    BorderThickness="0,0,0,1" IsHitTestVisible="False" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border x:Name="DefaultTitleIcon" Width="24" Height="24" CornerRadius="7" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE950;" FontSize="13" Foreground="White" />
                </Border>
                <Border x:Name="GamingTitleIcon" Width="24" Height="24" CornerRadius="3"
                        Background="#CE2143" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE950;" FontSize="13" Foreground="White" />
                </Border>
                <TextBlock Text="G Pro Control" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,3">
                    <TextBlock Text="G PRO" FontSize="10" Opacity="0.7" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border x:Name="GamingSidebar" Visibility="Collapsed" Width="176" Background="#181818"
                BorderBrush="#2B292C" BorderThickness="0,0,1,0" SizeChanged="GamingSidebar_SizeChanged">
            <Border.Clip><RectangleGeometry x:Name="GamingSidebarClip" /></Border.Clip>
            <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8" Padding="0,8,0,12">
                    <Button x:Name="GamingSidebarToggle" Click="GamingSidebarToggle_Click" Margin="8,0"
                            Width="40" Height="36" Padding="0" CornerRadius="7" Background="Transparent"
                            AutomationProperties.Name="收起侧边栏" ToolTipService.ToolTip="收起侧边栏">
                        <Grid Width="20" Height="20">
                            <SymbolIcon Symbol="GlobalNavigationButton" />
                        </Grid>
                    </Button>
                    <ListView x:Name="GamingNavigation" SelectionChanged="GamingNavigation_SelectionChanged"
                              ItemClick="GamingNavigation_ItemClick" IsItemClickEnabled="True"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionMode="Single" SingleSelectionFollowsFocus="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="42" />
                                <Setter Property="Margin" Value="4,1" />
                                <Setter Property="Padding" Value="11,0,7,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ListViewItemPresenter x:Name="SidebarItemPresenter" Control.IsTemplateFocusTarget="True"
                                                ContentMargin="{TemplateBinding Padding}" CornerRadius="7"
                                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalContentAlignment="Center"
                                                PointerOverBackground="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                PressedBackground="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                SelectedBackground="{ThemeResource ListViewItemBackgroundSelected}"
                                                SelectedPointerOverBackground="{ThemeResource ListViewItemBackgroundSelectedPointerOver}"
                                                SelectedPressedBackground="{ThemeResource ListViewItemBackgroundSelected}"
                                                SelectionIndicatorVisualEnabled="True" SelectionIndicatorMode="Overlay"
                                                SelectionIndicatorCornerRadius="1.5"
                                                SelectionIndicatorBrush="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                                                SelectionIndicatorPointerOverBrush="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                                                SelectionIndicatorPressedBrush="{ThemeResource ListViewItemSelectionIndicatorBrush}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#3E2026" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#50272F" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#FF324F" />
                        </ListView.Resources>
                        <ListViewItem Tag="dashboard" AutomationProperties.Name="概览">
                            <StackPanel Orientation="Horizontal" Spacing="12"><Grid Width="22" Height="22"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE80F;" FontSize="17" Width="18" Height="18" /></Grid><TextBlock Text="概览" /></StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="device" AutomationProperties.Name="设备">
                            <StackPanel Orientation="Horizontal" Spacing="12"><Grid Width="22" Height="22"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE770;" FontSize="17" Width="18" Height="18" /></Grid><TextBlock Text="设备" /></StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="lighting" AutomationProperties.Name="灯效">
                            <StackPanel Orientation="Horizontal" Spacing="12"><Grid Width="22" Height="22"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA80;" FontSize="17" Width="18" Height="18" /></Grid><TextBlock Text="灯效" /></StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="performance" AutomationProperties.Name="性能">
                            <StackPanel Orientation="Horizontal" Spacing="12"><Grid Width="22" Height="22"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D9;" FontSize="17" Width="18" Height="18" /></Grid><TextBlock Text="性能" /></StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="support" AutomationProperties.Name="我的服务">
                            <StackPanel Orientation="Horizontal" Spacing="12"><Grid Width="22" Height="22"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F2;" FontSize="17" Width="18" Height="18" /></Grid><TextBlock Text="我的服务" /></StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="settings" AutomationProperties.Name="设置">
                            <StackPanel Orientation="Horizontal" Spacing="12"><Grid Width="22" Height="22"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="17" Width="18" Height="18" /></Grid><TextBlock Text="设置" /></StackPanel>
                        </ListViewItem>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <NavigationView x:Name="Navigation"
                        Grid.Column="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        PaneDisplayMode="LeftCompact"
                        OpenPaneLength="184"
                        CompactPaneLength="52"
                        ItemInvoked="Navigation_ItemInvoked"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="dashboard" Icon="Home" />
                <NavigationViewItem Content="性能" Tag="performance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="灯效" Tag="lighting">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA80;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设备" Tag="device">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE770;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="我的服务" Tag="support">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid x:Name="RogWorkspaceBackdrop" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
                      AutomationProperties.AccessibilityView="Raw">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#111114" Offset="0" />
                            <GradientStop Color="#141416" Offset="0.56" />
                            <GradientStop Color="#26171E" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Viewbox MaxWidth="720" MaxHeight="360" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Canvas Width="720" Height="360">
                            <Path Fill="#103F2835" Data="M 330,0 L 470,0 110,360 0,360 Z M 540,0 L 720,0 720,61 421,360 180,360 Z" />
                            <Path Fill="#10A02745" Data="M 475,0 L 515,0 155,360 115,360 Z M 650,0 L 658,0 298,360 290,360 Z" />
                            <Path Stroke="#206B4252" StrokeThickness="1" Data="M480,0 L120,360 M518,0 L158,360 M599,0 L239,360 M661,0 L301,360" />
                        </Canvas>
                    </Viewbox>
                </Grid>
                <Button x:Name="PageBackButton" Style="{StaticResource SectionButtonStyle}" AutomationProperties.Name="返回上一级"
                        Click="PageBackButton_Click" Margin="24,12,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Back" />
                        <TextBlock Text="返回" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="ContentFrame_Navigated" />
            </Grid>
        </NavigationView>
        </Grid>
    </Grid>
</Window>
