<Window
    x:Class="GProControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="G Pro Control">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE950;" FontSize="13" Foreground="White" />
                </Border>
                <TextBlock Text="G Pro Control" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,3">
                    <TextBlock Text="PREVIEW" FontSize="10" Opacity="0.7" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Navigation"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        PaneDisplayMode="LeftCompact"
                        OpenPaneLength="184"
                        CompactPaneLength="52"
                        BackRequested="Navigation_BackRequested"
                        ItemInvoked="Navigation_ItemInvoked"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="dashboard" Icon="Home" />
                <NavigationViewItem Content="详细参数" Tag="details">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9CE;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="性能" Tag="performance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="灯效" Tag="lighting">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA80;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设备" Tag="device">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE770;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="我的服务" Tag="support">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>
