<Application
    x:Class="GProControl.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GProControl.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Views/RogToggleTemplate.xaml" />
                <ResourceDictionary Source="Views/GamingExpander.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#1F7F8490" />
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="views:RogSection.Adapt" Value="True" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="RogSectionStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
                <Setter Property="Background" Value="#1A191D" />
                <Setter Property="BorderBrush" Value="#623642" />
                <Setter Property="BorderThickness" Value="1,2,1,1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="LegionSectionStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
                <Setter Property="Background" Value="#182432" />
                <Setter Property="BorderBrush" Value="#304456" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="views:RogSection.Adapt" Value="True" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="RogSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
                <Setter Property="Foreground" Value="#FF889E" />
                <Setter Property="CharacterSpacing" Value="35" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
            <Style x:Key="LegionSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
                <Setter Property="Foreground" Value="#8BDFFF" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
            <Style x:Key="SectionButtonStyle" TargetType="Button">
                <Setter Property="views:RogSection.Adapt" Value="True" />
            </Style>
            <Style x:Key="RogSectionButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionButtonStyle}">
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Background" Value="#3C222D" />
                <Setter Property="BorderBrush" Value="#A93F57" />
                <Setter Property="Foreground" Value="#FFF1F5" />
            </Style>
            <Style x:Key="LegionSectionButtonStyle" TargetType="Button" BasedOn="{StaticResource SectionButtonStyle}">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="#21435A" />
                <Setter Property="BorderBrush" Value="#4D8BA5" />
                <Setter Property="Foreground" Value="#E4F8FF" />
            </Style>
            <Style x:Key="SectionExpanderStyle" TargetType="Expander">
                <Setter Property="views:RogSection.Adapt" Value="True" />
            </Style>
            <Style x:Key="RogSectionExpanderStyle" TargetType="Expander" BasedOn="{StaticResource SectionExpanderStyle}">
                <Setter Property="Template" Value="{StaticResource GamingExpanderTemplate}" />
                <Setter Property="Background" Value="#20191D" />
                <Setter Property="BorderBrush" Value="#773B4B" />
                <Setter Property="Foreground" Value="#FF9BAC" />
                <Setter Property="CornerRadius" Value="2" />
            </Style>
            <Style x:Key="LegionSectionExpanderStyle" TargetType="Expander" BasedOn="{StaticResource SectionExpanderStyle}">
                <Setter Property="Template" Value="{StaticResource GamingExpanderTemplate}" />
                <Setter Property="Background" Value="#182432" />
                <Setter Property="BorderBrush" Value="#3A596D" />
                <Setter Property="Foreground" Value="#9BE5FF" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
