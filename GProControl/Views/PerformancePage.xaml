<Page
    x:Class="GProControl.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GProControl.Views">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,32" Spacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="性能模式" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="通过原厂 MiDeviceService 切换 EC 功耗与散热策略" Opacity="0.62" />
            </StackPanel>
            <InfoBar x:Name="ControlInfo" IsOpen="True" Severity="Informational"
                     Title="安全检查中" Message="正在核对 TM2211、原厂版本和后台服务。" />
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="EC 性能模式" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="CurrentModeText" Text="正在读取当前模式…" Opacity="0.55" FontSize="12" />
                        </StackPanel>
                        <Button x:Name="RefreshModeButton" Content="重新读取" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="RefreshModeButton_Click" />
                    </Grid>
                    <Grid x:Name="ModeSelector" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="SilentModeButton" Content="静谧" Tag="0" IsEnabled="False"
                                     GroupName="PerformanceMode" Click="ModeButton_Click" />
                        <RadioButton x:Name="BalancedModeButton" Grid.Column="1" Content="均衡" Tag="1" IsEnabled="False"
                                     GroupName="PerformanceMode" Click="ModeButton_Click" />
                        <RadioButton x:Name="TurboModeButton" Grid.Column="2" Content="极速" Tag="2" IsEnabled="False"
                                     GroupName="PerformanceMode" Click="ModeButton_Click" />
                        <RadioButton x:Name="FullSpeedModeButton" Grid.Column="3" Content="狂暴" Tag="3" IsEnabled="False"
                                     GroupName="PerformanceMode" Click="ModeButton_Click" />
                    </Grid>
                    <TextBlock Text="四档模式同时控制原厂 EC 功耗与风扇策略；写入会串行执行并读回确认。固件未提供已验证的自定义曲线或固定 RPM 写入接口。"
                               Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="屏幕加速" Style="{StaticResource SectionTitleStyle}" />
                            <Button x:Name="RefreshScreenAccelerationButton" Content="回读状态"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="RefreshScreenAccelerationButton_Click" />
                        </Grid>
                        <TextBlock x:Name="ScreenAccelerationStatus" Text="使用原厂 business type 30 写入，并以原厂服务状态通报回读。"
                                   Opacity="0.58" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="ScreenAccelerationToggle" Header="实验性控制" Toggled="ScreenAccelerationToggle_Toggled" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                    <views:GraphicModeControl />
                </Border>
            </Grid>
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="WLAN 加速" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="直接显示小米控制中心后台服务的路由加速结果" Opacity="0.55" FontSize="12" />
                        </StackPanel>
                        <Button x:Name="RefreshWlanButton" Content="刷新状态" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="RefreshWlanButton_Click" />
                    </Grid>
                    <TextBlock x:Name="WlanStatusText" Text="正在读取原厂状态…" TextWrapping="Wrap" />
                    <TextBlock Text="原控制中心没有独立的本机强制开关；它会访问小米路由器 maccel / ma_check 接口。本页沿用同一后台结果。"
                               Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
