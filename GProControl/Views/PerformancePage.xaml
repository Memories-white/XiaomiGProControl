<Page
    x:Class="GProControl.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GProControl.Views">
    <Page.Resources>
        <SolidColorBrush x:Key="RogModeBackground" Color="#242127" />
        <SolidColorBrush x:Key="LegionModeBackground" Color="#172738" />
        <Style x:Key="ModeOption" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="ModeSurface" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ModeFeedback.Opacity" Value="0.08" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ModeFeedback.Opacity" Value="0.18" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ModeLabel.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="ModeSelection.Visibility" Value="Visible" />
                                            <Setter Target="ModeLabel.FontWeight" Value="Bold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                            <Border x:Name="ModeFeedback" Background="{TemplateBinding BorderBrush}" Opacity="0"
                                    CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                            <Grid x:Name="ModeSelection" Visibility="Collapsed" IsHitTestVisible="False">
                                <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding BorderBrush}" Opacity="0.14" />
                                <Border CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,3" />
                            </Grid>
                            <ContentPresenter x:Name="ModeLabel" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                              Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <views:RogPageLayout x:Name="Workspace" ResponsiveColumns="True" MaxWidth="1200" HorizontalAlignment="Center"
                             Padding="28,20,28,32" Spacing="16">
            <TextBlock views:RogPageLayout.Band="0" Text="性能模式" FontSize="28" FontWeight="SemiBold" />
            <InfoBar views:RogPageLayout.Band="1" x:Name="ControlInfo" IsOpen="True" Severity="Informational"
                     Title="安全检查中" Message="正在核对 TM2211、原厂版本和后台服务。" />

            <Border views:RogPageLayout.Band="2" x:Name="PerformanceModeCard" Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="EC 性能模式" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="CurrentModeText" Text="正在读取当前模式…" Opacity="0.72" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="RefreshModeButton" Grid.Column="1" Style="{StaticResource SectionButtonStyle}"
                                Content="重新读取" VerticalAlignment="Top" Click="RefreshModeButton_Click" />
                    </Grid>
                    <Grid x:Name="ModeSelector" ColumnSpacing="10" RowSpacing="8" SizeChanged="ModeSelector_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <RadioButton x:Name="SilentModeButton" Style="{StaticResource ModeOption}" Content="静谧"
                                     Tag="0" IsEnabled="False" GroupName="PerformanceMode" Click="ModeButton_Click" />
                        <RadioButton x:Name="BalancedModeButton" Grid.Column="1" Style="{StaticResource ModeOption}" Content="均衡"
                                     Tag="1" IsEnabled="False" GroupName="PerformanceMode" Click="ModeButton_Click" />
                        <RadioButton x:Name="TurboModeButton" Grid.Column="2" Style="{StaticResource ModeOption}" Content="极速"
                                     Tag="2" IsEnabled="False" GroupName="PerformanceMode" Click="ModeButton_Click" />
                        <RadioButton x:Name="FullSpeedModeButton" Grid.Column="3" Style="{StaticResource ModeOption}" Content="狂暴"
                                     Tag="3" IsEnabled="False" GroupName="PerformanceMode" Click="ModeButton_Click" />
                    </Grid>
                    <TextBlock Text="切换模式会同时调整功耗和风扇策略。" Opacity="0.60" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border views:RogPageLayout.Band="3" views:RogPageLayout.Lane="1" x:Name="GpuOverclockCard" Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="GPU 加速引擎" Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" x:Name="RefreshGpuOverclockButton" Style="{StaticResource SectionButtonStyle}"
                                Content="回读状态" IsEnabled="False" Click="RefreshGpuOverclockButton_Click" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <ProgressRing x:Name="GpuOverclockProgress" Width="16" Height="16" VerticalAlignment="Top"
                                      IsActive="False" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" x:Name="GpuOverclockStatus" Text="正在读取原厂状态…"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <ToggleSwitch x:Name="GpuOverclockToggle" Header="显卡超频" IsEnabled="False"
                                  views:RogToggleSwitch.Adapt="True" Toggled="GpuOverclockToggle_Toggled" />
                    <TextBlock Text="开启原厂超频预设需要接通电源并处于狂暴模式。" Opacity="0.60" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border views:RogPageLayout.Band="3" views:RogPageLayout.Lane="2" x:Name="GraphicModeCard" Style="{StaticResource DashboardCardStyle}">
                <views:GraphicModeControl />
            </Border>

            <Border views:RogPageLayout.Band="4" views:RogPageLayout.Lane="1" x:Name="ScreenAccelerationCard" Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="屏幕加速" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" x:Name="RefreshScreenAccelerationButton" Style="{StaticResource SectionButtonStyle}"
                                Content="回读状态" Click="RefreshScreenAccelerationButton_Click" />
                    </Grid>
                    <TextBlock x:Name="ScreenAccelerationStatus" Text="正在读取原厂状态…" TextWrapping="Wrap" />
                    <ToggleSwitch views:RogToggleSwitch.Adapt="True" x:Name="ScreenAccelerationToggle"
                                  Header="实验性控制" Toggled="ScreenAccelerationToggle_Toggled" />
                </StackPanel>
            </Border>

            <Border views:RogPageLayout.Band="4" views:RogPageLayout.Lane="2" Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="WLAN 加速" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" x:Name="RefreshWlanButton" Style="{StaticResource SectionButtonStyle}"
                                Content="刷新状态" Click="RefreshWlanButton_Click" />
                    </Grid>
                    <TextBlock x:Name="WlanStatusText" Text="正在读取原厂状态…" TextWrapping="Wrap" />
                    <TextBlock Text="显示小米路由器的加速状态，是否生效取决于路由器。" Opacity="0.60" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </views:RogPageLayout>
    </ScrollViewer>
</Page>
