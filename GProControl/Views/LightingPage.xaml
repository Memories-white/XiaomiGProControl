<Page
    x:Class="GProControl.Views.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,32" Spacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="键盘灯效" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="简洁地管理亮度、颜色与动态效果" Opacity="0.62" />
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar" IsOpen="True" Severity="Informational" Title="正在验证灯效控制"
                     Message="正在读取键盘版本和当前灯效。" />

            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="原厂灯效预设" Style="{StaticResource SectionTitleStyle}" />
                        <Button x:Name="ResetPresetButton" Content="恢复当前效果默认参数" HorizontalAlignment="Right" Click="ResetPreset_Click" />
                    </Grid>
                    <TextBlock Text="选择预设后点击“应用灯效”生效。光影随行与光音视界目前使用基础联动。" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    <ItemsControl x:Name="PresetList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="220" ItemHeight="76" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="Preset_Click">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Border Background="{Binding PreviewColor}" CornerRadius="2" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DashboardCardStyle}" MinHeight="290">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="灯效预览" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="内置 RGB 键盘" Opacity="0.55" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Row="1" Margin="0,20" CornerRadius="18" Padding="28"
                                BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#332E8BFF" Offset="0" />
                                    <GradientStop Color="#3359D9B7" Offset="0.52" />
                                    <GradientStop Color="#337C5CFC" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <FontIcon Glyph="&#xE765;" FontSize="44" Opacity="0.88" />
                                <StackPanel x:Name="MatrixPreviewPanel" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="实时输出矩阵 · 7 × 17" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                                    <ItemsControl x:Name="MatrixPreviewList" Width="306" Height="98">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="17" ItemWidth="18" ItemHeight="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding}" Margin="1" CornerRadius="2" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock x:Name="LightingPreviewText" Text="等待读取" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Border Width="18" Height="18" CornerRadius="9" Background="#2E8BFF" />
                            <Border Width="18" Height="18" CornerRadius="9" Background="#59D9B7" />
                            <Border Width="18" Height="18" CornerRadius="9" Background="#7C5CFC" />
                            <TextBlock x:Name="LightingSourceText" Text="尚未读取原厂日志" VerticalAlignment="Center" Opacity="0.55" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <TextBlock Text="当前灯效状态" Style="{StaticResource SectionTitleStyle}" />
                            <Button x:Name="RefreshButton" Content="刷新" HorizontalAlignment="Right" Click="Refresh_Click" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="键盘灯" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="PowerValueText" Text="未知" VerticalAlignment="Center" Opacity="0.7" />
                                <Button x:Name="PowerButton" Content="开关" IsEnabled="False" Click="Power_Click" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="8">
                            <TextBlock Text="效果" FontWeight="SemiBold" />
                            <ComboBox x:Name="EffectSelector" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="Effect_Changed" />
                            <TextBlock x:Name="EffectDescription" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            <ColorPicker x:Name="EffectColor" Color="#FF4F8CFF" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" Visibility="Collapsed" />
                            <StackPanel x:Name="OutputOptionsPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="动态灯效输出" FontWeight="SemiBold" />
                                <ComboBox x:Name="OutputModeBox" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OutputMode_Changed"><x:String>整键盘统一颜色</x:String><x:String>逐键映射 / 频谱柱</x:String></ComboBox>
                                <Button x:Name="RealtimeTestButton" Content="校验逐键灯效（16 秒）" Click="ValidateRealtime_Click" HorizontalAlignment="Stretch" />
                                <TextBlock x:Name="RealtimeStatusText" Text="先观察颜色分区及光带，校验后开放逐键输出。" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="AudioOptionsPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="音频采集源" FontWeight="SemiBold" />
                                <ComboBox x:Name="AudioSourceBox" HorizontalAlignment="Stretch" SelectedIndex="0"><x:String>系统播放声音</x:String><x:String>默认麦克风</x:String></ComboBox>
                                <TextBlock Text="呈现方式" FontWeight="SemiBold" />
                                <ComboBox x:Name="AudioStyleBox" HorizontalAlignment="Stretch" SelectedIndex="0"><x:String>音量呼吸 · 自选单色</x:String><x:String>频谱柱 / 渐变混色</x:String></ComboBox>
                                <TextBlock Text="频谱柱方向（逐键输出）" FontSize="12" Opacity="0.6" />
                                <ComboBox x:Name="SpectrumDirectionBox" HorizontalAlignment="Stretch" SelectedIndex="0"><x:String>向上</x:String><x:String>向下</x:String><x:String>向左</x:String><x:String>向右</x:String></ComboBox>
                                <TextBlock Text="原厂频谱配色" FontWeight="SemiBold" />
                                <ComboBox x:Name="AudioPaletteBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectedIndex="0" />
                                <TextBlock Text="频段预览 · 低频 → 高频" FontSize="12" Opacity="0.6" />
                                <ItemsControl x:Name="SpectrumList">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Grid Height="55" Width="10"><Border Height="{Binding}" VerticalAlignment="Bottom" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel x:Name="ScreenOptionsPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="屏幕采样密度" FontWeight="SemiBold" />
                                <Slider x:Name="ScreenSamplesSlider" Minimum="1" Maximum="5" Value="4" StepFrequency="1" />
                                <TextBlock Text="统一输出使用平均色；逐键输出将主屏幕映射到 7×17 矩阵，不保存屏幕画面。" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="配色 / 方向" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PaletteComboBox" IsEnabled="False" HorizontalAlignment="Stretch" />
                                <ComboBox x:Name="DirectionComboBox" Grid.Column="1" IsEnabled="False" HorizontalAlignment="Stretch">
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="亮度" FontWeight="SemiBold" />
                            <ComboBox x:Name="BrightnessComboBox" IsEnabled="False" HorizontalAlignment="Stretch">
                                <x:String>1 档</x:String>
                                <x:String>2 档</x:String>
                                    <x:String>3 档</x:String>
                                    <x:String>4 档</x:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="速度" FontWeight="SemiBold" />
                            <ComboBox x:Name="SpeedComboBox" IsEnabled="False" HorizontalAlignment="Stretch">
                                <x:String>1 档</x:String>
                                <x:String>2 档</x:String>
                                <x:String>3 档</x:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="动态长度" FontWeight="SemiBold" />
                            <ComboBox x:Name="LengthComboBox" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <Button x:Name="ApplyButton" Content="应用灯效" Click="Apply_Click"
                                IsEnabled="False" HorizontalAlignment="Stretch" />
                        <Button x:Name="StopAmbientButton" Content="停止动态灯效" Visibility="Collapsed" Click="StopAmbient_Click" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
