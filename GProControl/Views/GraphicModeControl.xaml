<UserControl
    x:Class="GProControl.Views.GraphicModeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <Grid>
            <TextBlock Text="显卡输出模式" Style="{StaticResource SectionTitleStyle}" />
            <Button x:Name="RefreshButton" Content="刷新" HorizontalAlignment="Right" Click="Refresh_Click" />
        </Grid>
        <TextBlock x:Name="ModeText" Text="正在读取…" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Text="正在自动检查设备控制…" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button x:Name="HybridButton" Content="混合输出" Tag="0" HorizontalAlignment="Stretch" IsEnabled="False" Click="Switch_Click" />
            <Button x:Name="DirectButton" Grid.Column="1" Content="独显直连" Tag="1" HorizontalAlignment="Stretch" IsEnabled="False" Click="Switch_Click" />
        </Grid>
        <InfoBar x:Name="RestartNotice" IsOpen="False" Severity="Warning" IsClosable="False"
                 Title="重启后生效" Message="显卡模式已保存。请先保存工作，再自行重启 Windows。" />
        <TextBlock Text="混合输出适合日常使用；独显直连适合游戏。此处显示固件保存的模式，切换后需要重启。"
                   FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
