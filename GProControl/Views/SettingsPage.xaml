<Page
    x:Class="GProControl.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:views="using:GProControl.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <views:RogPageLayout x:Name="Workspace" Padding="28,20,28,32" Spacing="18">
            <TextBlock views:RogPageLayout.Band="0" views:RogPageLayout.Lane="0" Text="设置" FontSize="28" FontWeight="SemiBold" />
            <Border views:RogPageLayout.Band="1" views:RogPageLayout.Lane="1" Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="个性化" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="界面风格" FontWeight="SemiBold" />
                            <TextBlock Text="选择简约、ROG 红黑或拯救者仪表盘" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="AppearanceSelector" Grid.Column="1" Width="152"
                                  AutomationProperties.Name="界面风格" SelectionChanged="AppearanceSelector_SelectionChanged">
                            <ComboBoxItem Content="Windows 11 简约" />
                            <ComboBoxItem Content="ROG 风格" />
                            <ComboBoxItem Content="拯救者风格" />
                        </ComboBox>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="应用主题" FontWeight="SemiBold" /><TextBlock Text="用于 Windows 11 简约风格，可跟随系统或固定浅色 / 深色" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="ThemeSelector" Grid.Column="1" Width="152" SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
            <Border views:RogPageLayout.Band="1" views:RogPageLayout.Lane="2" Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="显示与关闭行为" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="隐藏常规提示" FontWeight="SemiBold" />
                            <TextBlock Text="隐藏服务入口说明、硬件写入已解锁、灯效已同步和自检通过提示。"
                                       Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch views:RogToggleSwitch.Adapt="True" x:Name="HideRoutineNoticesToggle" Grid.Column="1"
                                      AutomationProperties.Name="隐藏常规提示" Toggled="HideRoutineNoticesToggle_Toggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="网络速率单位" FontWeight="SemiBold" /><TextBlock Text="用于设备概览中的下载和上传速度" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="NetworkSpeedUnitSelector" Grid.Column="1" Width="152"
                                  AutomationProperties.Name="网络速率单位"
                                  SelectionChanged="NetworkSpeedUnitSelector_SelectionChanged">
                            <ComboBoxItem Content="Kbps" />
                            <ComboBoxItem Content="MB/s" />
                        </ComboBox>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="点击关闭按钮时" FontWeight="SemiBold" /><TextBlock Text="可在关闭对话框中勾选“不再询问”，也可随时在这里修改" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="CloseActionSelector" Grid.Column="1" Width="152" SelectionChanged="CloseActionSelector_SelectionChanged">
                            <ComboBoxItem Content="每次询问" />
                            <ComboBoxItem Content="转入后台" />
                            <ComboBoxItem Content="退出软件" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="后台运行时，可点击通知区域图标恢复窗口，右键图标可直接退出。" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border views:RogPageLayout.Band="1" views:RogPageLayout.Lane="1" Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="启动与设置恢复" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="开机自启动" FontWeight="SemiBold" /><TextBlock x:Name="StartupDetail" Text="登录 Windows 后通过管理员计划任务启动" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch views:RogToggleSwitch.Adapt="True" x:Name="StartupToggle" Grid.Column="1" Toggled="StartupToggle_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="开机启动后转入后台" FontWeight="SemiBold" /><TextBlock Text="仅影响登录时自启动；手动打开仍显示主界面" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch views:RogToggleSwitch.Adapt="True" x:Name="StartupBackgroundToggle" Grid.Column="1" Toggled="StartupBackgroundToggle_Toggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="恢复上次性能模式" FontWeight="SemiBold" /><TextBlock x:Name="RestoreModeDetail" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch views:RogToggleSwitch.Adapt="True" x:Name="RestoreModeToggle" Grid.Column="1" Toggled="RestoreModeToggle_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="恢复上次键盘灯效" FontWeight="SemiBold" /><TextBlock x:Name="RestoreLightingDetail" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch views:RogToggleSwitch.Adapt="True" x:Name="RestoreLightingToggle" Grid.Column="1" Toggled="RestoreLightingToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border views:RogPageLayout.Band="1" views:RogPageLayout.Lane="2" Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="本次运行允许硬件写入" FontWeight="SemiBold" /><TextBlock x:Name="HardwareGuardDetail" Text="正在检查机型与原厂服务…" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                    <ToggleSwitch views:RogToggleSwitch.Adapt="True" x:Name="HardwareWriteToggle" Grid.Column="1" Toggled="HardwareWriteToggle_Toggled" />
                </Grid>
            </Border>
            <TextBlock views:RogPageLayout.Band="2" views:RogPageLayout.Lane="0" x:Name="VersionText" Text="G Pro Control" Opacity="0.5" FontSize="12" />
        </views:RogPageLayout>
    </ScrollViewer>
</Page>
