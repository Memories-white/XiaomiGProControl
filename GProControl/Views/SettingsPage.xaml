<Page
    x:Class="GProControl.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,32" Spacing="18">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="外观与关闭行为" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="应用主题" FontWeight="SemiBold" /><TextBlock Text="跟随 Windows，或固定使用浅色 / 深色" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="ThemeSelector" Grid.Column="1" Width="152" SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="网络速率单位" FontWeight="SemiBold" /><TextBlock Text="用于设备概览中的下载和上传速度" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="NetworkSpeedUnitSelector" Grid.Column="1" Width="152"
                                  AutomationProperties.Name="网络速率单位"
                                  SelectionChanged="NetworkSpeedUnitSelector_SelectionChanged">
                            <ComboBoxItem Content="Kbps" />
                            <ComboBoxItem Content="MB/s" />
                        </ComboBox>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="点击关闭按钮时" FontWeight="SemiBold" /><TextBlock Text="可在关闭对话框中勾选“不再询问”，也可随时在这里修改" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ComboBox x:Name="CloseActionSelector" Grid.Column="1" Width="152" SelectionChanged="CloseActionSelector_SelectionChanged">
                            <ComboBoxItem Content="每次询问" />
                            <ComboBoxItem Content="转入后台" />
                            <ComboBoxItem Content="退出软件" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="后台运行时，可点击通知区域图标恢复窗口，右键图标可直接退出。" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="启动与设置恢复" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="开机自启动" FontWeight="SemiBold" /><TextBlock x:Name="StartupDetail" Text="登录 Windows 后通过管理员计划任务启动" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Toggled="StartupToggle_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="开机启动后转入后台" FontWeight="SemiBold" /><TextBlock Text="仅影响登录时自启动；手动打开仍显示主界面" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="StartupBackgroundToggle" Grid.Column="1" Toggled="StartupBackgroundToggle_Toggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="恢复上次性能模式" FontWeight="SemiBold" /><TextBlock x:Name="RestoreModeDetail" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="RestoreModeToggle" Grid.Column="1" Toggled="RestoreModeToggle_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="恢复上次键盘灯效" FontWeight="SemiBold" /><TextBlock x:Name="RestoreLightingDetail" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="RestoreLightingToggle" Grid.Column="1" Toggled="RestoreLightingToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="本次运行允许硬件写入" FontWeight="SemiBold" /><TextBlock x:Name="HardwareGuardDetail" Text="正在检查机型与原厂服务…" Opacity="0.6" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                    <ToggleSwitch x:Name="HardwareWriteToggle" Grid.Column="1" Toggled="HardwareWriteToggle_Toggled" />
                </Grid>
            </Border>
            <TextBlock x:Name="VersionText" Text="G Pro Control" Opacity="0.5" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
