<Page
    x:Class="GProControl.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Padding="28,20,28,32" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="设备概览" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="小米 G Pro 2024 · 实时状态" Opacity="0.62" />
                </StackPanel>
                <Button x:Name="OpenDetailsButton" Grid.Column="1" VerticalAlignment="Center"
                        Click="OpenDetails_Click" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                        <TextBlock Text="详细参数" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE76C;" FontSize="10" Opacity="0.65" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <TextBlock Text="处理器" FontWeight="SemiBold" />
                            <Button x:Name="RefreshThermalFanButton" Content="刷新传感器"
                                    HorizontalAlignment="Right" Padding="10,4"
                                    Click="RefreshThermalFan_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                            <TextBlock x:Name="CpuUsageText" Text="--%" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="利用率" Margin="0,0,0,5" Opacity="0.6" />
                        </StackPanel>
                        <ProgressBar x:Name="CpuUsageBar" Maximum="100" Height="6" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="CPU 温度" Opacity="0.55" FontSize="12" /><TextBlock x:Name="CpuTemperatureText" Text="读取中…" FontSize="13" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="CPU 风扇" Opacity="0.55" FontSize="12" /><TextBlock x:Name="CpuFanText" Text="读取中…" FontSize="13" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <TextBlock Text="显卡" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE7F4;" HorizontalAlignment="Right" Opacity="0.55" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                            <TextBlock x:Name="GpuUsageText" Text="--%" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock x:Name="GpuNameText" Text="检测中" Margin="0,0,0,5" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ProgressBar x:Name="GpuUsageBar" Maximum="100" Height="6" Value="0" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="温度" Opacity="0.55" FontSize="12" /><TextBlock x:Name="GpuTemperatureText" Text="—" FontSize="13" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="功耗" Opacity="0.55" FontSize="12" /><TextBlock x:Name="GpuPowerText" Text="—" FontSize="13" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="显存" Opacity="0.55" FontSize="12" /><TextBlock x:Name="GpuMemoryText" Text="—" FontSize="13" /></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="GPU 风扇" Opacity="0.55" FontSize="12" /><TextBlock x:Name="GpuFanText" Text="读取中…" FontSize="13" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="内存" FontWeight="SemiBold" />
                        <TextBlock x:Name="MemoryText" Text="-- / -- GB" FontSize="22" FontWeight="SemiBold" />
                        <ProgressBar x:Name="MemoryBar" Maximum="100" Height="6" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="系统磁盘" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiskText" Text="-- / -- GB" FontSize="22" FontWeight="SemiBold" />
                        <ProgressBar x:Name="DiskBar" Maximum="100" Height="6" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="网络" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="下载" Opacity="0.55" FontSize="12" /><TextBlock x:Name="DownloadText" Text="—" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="上传" Opacity="0.55" FontSize="12" /><TextBlock x:Name="UploadText" Text="—" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="性能模式" FontWeight="SemiBold" />
                        <TextBlock x:Name="DashboardModeText" Text="等待原厂服务读回" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="已验证控制默认可用；可在设置中恢复上次模式。" Opacity="0.55" FontSize="12" />
                    </StackPanel>
                    <Button x:Name="OpenPerformanceButton" Grid.Column="1" Content="查看模式" VerticalAlignment="Center" Click="OpenPerformance_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="12"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}">
                        <FontIcon Glyph="&#xE968;" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="原厂兼容桥" FontWeight="SemiBold" />
                        <TextBlock x:Name="BridgeDetailText" Text="正在检测原厂组件…" Opacity="0.58" FontSize="12" />
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="11" Padding="10,5" VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="BridgeStatusDot" Width="7" Height="7" Fill="{ThemeResource TextFillColorDisabledBrush}" />
                            <TextBlock x:Name="BridgeStatusText" Text="检测中" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
