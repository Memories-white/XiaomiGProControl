<Page x:Class="GProControl.Views.DetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <DataTemplate x:Key="SectionTemplate">
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Rectangle Width="3" Height="17" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="14" Margin="0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Padding="28,20,28,32" Spacing="16" MaxWidth="1280">
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="设备概览 / 硬件配置" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12" />
                        <TextBlock Text="详细参数" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummaryText" Text="整机、固件与硬件配置"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RefreshButton" Content="刷新参数" Click="Refresh_Click" />
                        <Button x:Name="CopyButton" Content="复制参数报告" Click="Copy_Click" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <InfoBar x:Name="StatusBar" IsOpen="True" Title="正在读取设备参数" />
            <Grid x:Name="SectionGrid" ColumnSpacing="14" RowSpacing="14" SizeChanged="SectionGrid_SizeChanged" />
            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="设备序列号" FontWeight="SemiBold" />
                        <TextBlock x:Name="SerialText" Text="隐藏" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RevealSerialToggle" Grid.Column="1" OffContent="显示" OnContent="已显示" Toggled="RevealSerial_Toggled" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
