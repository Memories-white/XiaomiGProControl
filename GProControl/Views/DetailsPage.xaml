<Page x:Class="GProControl.Views.DetailsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,32" Spacing="18">
            <TextBlock Text="详细参数" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="整机、固件与硬件配置 · 从本机读取" Opacity="0.62" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="RefreshButton" Content="刷新参数" Click="Refresh_Click" />
                <Button x:Name="CopyButton" Content="复制参数报告" Click="Copy_Click" IsEnabled="False" />
            </StackPanel>
            <InfoBar x:Name="StatusBar" IsOpen="True" Title="正在读取设备参数" />
            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6"><TextBlock Text="设备序列号" FontWeight="SemiBold" /><TextBlock x:Name="SerialText" Text="隐藏" IsTextSelectionEnabled="True" /></StackPanel>
                    <ToggleSwitch x:Name="RevealSerialToggle" Grid.Column="1" OffContent="显示序列号" OnContent="已显示序列号" Toggled="RevealSerial_Toggled" />
                </Grid>
            </Border>
            <ItemsControl x:Name="SectionList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,14">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="18" Margin="0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Opacity="0.6" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
