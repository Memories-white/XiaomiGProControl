<Page x:Class="GProControl.Views.DetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:views="using:GProControl.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <DataTemplate x:Key="SectionTemplate">
            <Border Style="{StaticResource DashboardCardStyle}" Padding="14,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer>
        <views:RogPageLayout x:Name="Workspace" Padding="28,20,28,32" Spacing="14" MaxWidth="1480">
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                    Padding="0,0,0,14">
                <Grid SizeChanged="Header_SizeChanged" ColumnSpacing="16" RowSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="HeaderText" Spacing="5">
                        <TextBlock Text="详细参数" FontSize="30" FontWeight="Bold" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock x:Name="SummaryText" Text="整机、固件与硬件配置" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Spacing="8">
                        <Button x:Name="RefreshButton" Style="{StaticResource SectionButtonStyle}" Click="Refresh_Click" AutomationProperties.Name="刷新参数">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Refresh" />
                                <TextBlock Text="刷新" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopyButton" Style="{StaticResource SectionButtonStyle}" Click="Copy_Click" IsEnabled="False" AutomationProperties.Name="复制参数报告">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Copy" />
                                <TextBlock Text="复制报告" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <InfoBar views:RogPageLayout.Band="1" x:Name="StatusBar" IsOpen="True" Title="正在读取设备参数" />
            <Grid views:RogPageLayout.Band="2" x:Name="SectionGrid" ColumnSpacing="12" RowSpacing="12"
                  SizeChanged="SectionGrid_SizeChanged" />
            <Expander x:Name="VirtualAdapters" Style="{StaticResource SectionExpanderStyle}"
                      views:RogPageLayout.Band="3" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <SymbolIcon Symbol="View" />
                        <TextBlock x:Name="VirtualAdapterHeader" Text="虚拟显示适配器" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Expander.Header>
                <Grid x:Name="VirtualAdapterGrid" ColumnSpacing="12" RowSpacing="12" SizeChanged="VirtualAdapterGrid_SizeChanged" />
            </Expander>
            <Border views:RogPageLayout.Band="4" Style="{StaticResource DashboardCardStyle}" Padding="14,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="设备序列号" FontWeight="SemiBold" />
                        <TextBlock x:Name="SerialText" Text="隐藏 · 仅在本机显示" IsTextSelectionEnabled="True"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch views:RogToggleSwitch.Adapt="True" x:Name="RevealSerialToggle" Grid.Column="1" OffContent="显示" OnContent="已显示" Toggled="RevealSerial_Toggled" />
                </Grid>
            </Border>
        </views:RogPageLayout>
    </ScrollViewer>
</Page>
