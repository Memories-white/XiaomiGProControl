<Page x:Class="GProControl.Views.SupportPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,32" Spacing="18">
            <TextBlock Text="我的服务" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="服务与反馈、用户中心及软件信息" Opacity="0.62" />
            <InfoBar x:Name="StatusBar" IsOpen="True" Severity="Informational" Title="小米官方服务入口" Message="服务页面将在默认浏览器打开；保修和订单信息由小米官网提供。" />
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="服务与反馈" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl x:Name="LinkList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OpenLink_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,3" Padding="14,12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" /></StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE8A7;" FontSize="15" VerticalAlignment="Center" Opacity="0.6" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="CopyDiagnosticsButton" Content="复制诊断摘要" Click="CopyDiagnostics_Click" />
                    <TextBlock Text="包含软件版本、原厂组件状态及设备参数；不包含序列号，不会自动发送。" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    <Button x:Name="ExportLogButton" Content="导出运行日志" Click="ExportLog_Click" />
                    <TextBlock Text="将启动、控制操作和错误记录保存为文本文件，便于排查问题。" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="用户中心" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="通过小米账号官网管理账号。登录和售后订单操作在浏览器中完成。" TextWrapping="Wrap" Opacity="0.65" />
                    <Button Content="打开小米账号" Tag="https://account.xiaomi.com/" Click="OpenAccount_Click" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="VersionText" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="非官方 Redmi G Pro 2024 控制中心 · WinUI 3 / .NET" Opacity="0.65" TextWrapping="Wrap" />
                    <TextBlock x:Name="BridgeText" TextWrapping="Wrap" Opacity="0.65" />
                    <HyperlinkButton Content="项目源码与逆向文档" NavigateUri="https://github.com/Memories-white/XiaomiGProControl" Padding="0,4" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
