<UserControl x:Class="GProControl.Views.ZoneGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Grid Width="220" Height="146">
            <Canvas x:Name="Dial" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" Margin="0,18,0,0">
                <TextBlock Text="{x:Bind Label, Mode=OneWay}" Foreground="#439AFF"
                           FontSize="23" FontWeight="Bold" FontStyle="Italic" TextAlignment="Center" />
                <TextBlock Text="{x:Bind Reading, Mode=OneWay}" Foreground="#EDF4FF"
                           FontSize="36" FontWeight="Bold" FontStyle="Italic" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
